{
  "datasets": [
    {
      "name": "transaction_volume",
      "displayName": "Transaction Volume (Sliding Window)",
      "config": {
        "version": "1.1",
        "source": "finance.gold.transaciton_count_by_minute_sliding_window",
        "dimensions": [
          {
            "name": "window_start",
            "expr": "window_start"
          },
          {
            "name": "window_end",
            "expr": "window_end"
          }
        ],
        "measures": [
          {
            "name": "transaction_count",
            "expr": "SUM(transaction_count)"
          }
        ]
      }
    },
    {
      "name": "transactions",
      "displayName": "Transactions",
      "config": {
        "version": "1.1",
        "source": "finance.silver.transactions",
        "dimensions": [
          {
            "name": "transaction_date",
            "expr": "DATE(transaction_timestamp)"
          },
          {
            "name": "transaction_hour",
            "expr": "HOUR(transaction_timestamp)"
          },
          {
            "name": "payment_channel",
            "expr": "payment_channel"
          },
          {
            "name": "is_international",
            "expr": "is_international"
          },
          {
            "name": "merchant_name",
            "expr": "merchant_name"
          },
          {
            "name": "merchant_category",
            "expr": "merchant_category"
          },
          {
            "name": "city",
            "expr": "city"
          },
          {
            "name": "country",
            "expr": "country"
          },
          {
            "name": "status",
            "expr": "status"
          },
          {
            "name": "transaction_type",
            "expr": "transaction_type"
          }
        ],
        "measures": [
          {
            "name": "transaction_count",
            "expr": "COUNT(*)"
          },
          {
            "name": "total_amount",
            "expr": "SUM(amount)"
          },
          {
            "name": "avg_amount",
            "expr": "AVG(amount)"
          },
          {
            "name": "transactions_today",
            "expr": "COUNT(CASE WHEN DATE(transaction_timestamp) = CURRENT_DATE() THEN 1 END)"
          },
          {
            "name": "amount_today",
            "expr": "SUM(CASE WHEN DATE(transaction_timestamp) = CURRENT_DATE() THEN amount END)"
          },
          {
            "name": "successful_transactions",
            "expr": "COUNT(CASE WHEN status = 'approved' THEN 1 END)"
          },
          {
            "name": "success_rate",
            "expr": "COUNT(CASE WHEN status = 'approved' THEN 1 END) * 100.0 / COUNT(*)"
          }
        ]
      }
    },
    {
      "name": "high_value_alerts",
      "displayName": "High Value Alerts",
      "config": {
        "version": "1.1",
        "source": "finance.gold.high_value_transactions_alert",
        "dimensions": [
          {
            "name": "alert_timestamp",
            "expr": "alert_timestamp"
          },
          {
            "name": "merchant_category",
            "expr": "merchant_category"
          },
          {
            "name": "merchant_name",
            "expr": "merchant_name"
          },
          {
            "name": "customer_name",
            "expr": "customer_name"
          },
          {
            "name": "customer_email",
            "expr": "customer_email"
          },
          {
            "name": "city",
            "expr": "city"
          },
          {
            "name": "country",
            "expr": "country"
          }
        ],
        "measures": [
          {
            "name": "alert_count",
            "expr": "COUNT(*)"
          },
          {
            "name": "total_high_value_amount",
            "expr": "SUM(transaction_amount)"
          },
          {
            "name": "avg_transaction_amount",
            "expr": "AVG(transaction_amount)"
          }
        ]
      }
    },
    {
      "name": "fraud_alerts",
      "displayName": "Fraud Alerts",
      "config": {
        "version": "1.1",
        "source": "finance.gold.fraud_card_alert",
        "dimensions": [
          {
            "name": "alert_timestamp",
            "expr": "alert_timestamp"
          },
          {
            "name": "risk_level",
            "expr": "risk_level"
          },
          {
            "name": "reason_description",
            "expr": "reason_description"
          },
          {
            "name": "customer_name",
            "expr": "customer_name"
          },
          {
            "name": "customer_email",
            "expr": "customer_email"
          },
          {
            "name": "merchant_name",
            "expr": "merchant_name"
          },
          {
            "name": "merchant_category",
            "expr": "merchant_category"
          },
          {
            "name": "transaction_city",
            "expr": "transaction_city"
          },
          {
            "name": "transaction_country",
            "expr": "transaction_country"
          }
        ],
        "measures": [
          {
            "name": "alert_count",
            "expr": "COUNT(*)"
          },
          {
            "name": "total_fraud_amount",
            "expr": "SUM(amount)"
          }
        ]
      }
    },
    {
      "name": "customer_risk",
      "displayName": "Customer Risk Analysis",
      "config": {
        "version": "1.1",
        "source": "WITH fraud_summary AS (\n  SELECT \n    customer_id,\n    COUNT(*) AS fraud_count,\n    SUM(amount) AS total_fraud_amount,\n    MAX(alert_timestamp) AS last_fraud_date,\n    MAX(risk_level) AS max_risk_level\n  FROM finance.gold.fraud_card_alert\n  GROUP BY customer_id\n) SELECT \n  c.customer_id,\n  c.first_name,\n  c.last_name,\n  CONCAT(c.first_name, ' ', c.last_name) AS customer_name,\n  c.email,\n  c.city,\n  c.state,\n  c.country,\n  c.age,\n  c.gender,\n  c.customer_segment,\n  c.risk_score,\n  COALESCE(f.fraud_count, 0) AS fraud_count,\n  COALESCE(f.total_fraud_amount, 0) AS total_fraud_amount,\n  f.last_fraud_date,\n  f.max_risk_level\nFROM finance.silver.customers c LEFT JOIN fraud_summary f ON c.customer_id = f.customer_id\n",
        "dimensions": [
          {
            "name": "customer_id",
            "expr": "customer_id"
          },
          {
            "name": "first_name",
            "expr": "first_name"
          },
          {
            "name": "last_name",
            "expr": "last_name"
          },
          {
            "name": "customer_name",
            "expr": "customer_name"
          },
          {
            "name": "email",
            "expr": "email"
          },
          {
            "name": "city",
            "expr": "city"
          },
          {
            "name": "state",
            "expr": "state"
          },
          {
            "name": "country",
            "expr": "country"
          },
          {
            "name": "age",
            "expr": "age"
          },
          {
            "name": "gender",
            "expr": "gender"
          },
          {
            "name": "customer_segment",
            "expr": "customer_segment"
          },
          {
            "name": "last_fraud_date",
            "expr": "last_fraud_date"
          },
          {
            "name": "max_risk_level",
            "expr": "max_risk_level"
          }
        ],
        "measures": [
          {
            "name": "fraud_count",
            "expr": "SUM(fraud_count)"
          },
          {
            "name": "total_fraud_amount",
            "expr": "SUM(total_fraud_amount)"
          },
          {
            "name": "avg_risk_score",
            "expr": "AVG(risk_score)"
          },
          {
            "name": "customer_count",
            "expr": "COUNT(DISTINCT customer_id)"
          },
          {
            "name": "high_risk_customers",
            "expr": "COUNT(DISTINCT CASE WHEN risk_score > 70 THEN customer_id END)"
          }
        ]
      }
    }
  ],
